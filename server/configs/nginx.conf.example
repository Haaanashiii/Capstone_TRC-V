# NGINX Configuration for TRC-V Self-Hosted Backend
# =================================================
# 
# SETUP INSTRUCTIONS:
# 1. Copy this file: sudo cp nginx.conf.example /etc/nginx/sites-available/trc-v-api
# 2. Edit the file and replace:
#    - api.trc-v.gov.ph → your actual domain
#    - /path/to/server/uploads/ → actual path (e.g., /var/www/trc-v/server/uploads/)
# 3. Enable it: sudo ln -s /etc/nginx/sites-available/trc-v-api /etc/nginx/sites-enabled/
# 4. Get SSL cert: sudo certbot --nginx -d api.trc-v.gov.ph
# 5. Test config: sudo nginx -t
# 6. Reload: sudo systemctl reload nginx
#
# For frontend (if hosting both):
# - Create separate config for trc-v.gov.ph pointing to your React build folder
# - Or use Vercel for frontend and this server for API only

# HTTP -> HTTPS redirect
server {
    listen 80;
    server_name api.trc-v.gov.ph;
    return 301 https://$server_name$request_uri;
}

# Main HTTPS server
server {
    listen 443 ssl http2;
    server_name api.trc-v.gov.ph;

    # SSL Configuration (Let's Encrypt)
    ssl_certificate /etc/letsencrypt/live/api.trc-v.gov.ph/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/api.trc-v.gov.ph/privkey.pem;
    
    # Modern SSL settings
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384;
    ssl_prefer_server_ciphers off;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 1d;

    # Security Headers
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-XSS-Protection "1; mode=block" always;
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;

    # File upload size limit
    client_max_body_size 15M;

    # ============================================
    # PERFORMANCE OPTIMIZATIONS FOR 10K+ DOCUMENTS
    # ============================================
    
    # Increase timeouts for large data operations
    proxy_connect_timeout 60s;
    proxy_send_timeout 120s;
    proxy_read_timeout 120s;
    
    # Connection keepalive (reduces connection overhead)
    keepalive_timeout 65;
    keepalive_requests 100;

    # Main API proxy
    location / {
        proxy_pass http://127.0.0.1:5170;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection 'upgrade';
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_cache_bypass $http_upgrade;
        
        # Buffer settings for API responses
        proxy_buffering on;
        proxy_buffer_size 128k;
        proxy_buffers 4 256k;
        proxy_busy_buffers_size 256k;
    }

    # WebSocket support for Socket.IO (real-time updates)
    location /socket.io/ {
        proxy_pass http://127.0.0.1:5170;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        
        # Long timeout for WebSocket connections
        proxy_read_timeout 86400s;
        proxy_send_timeout 86400s;
    }

    # Health check (no logging, no rate limit)
    location /health {
        proxy_pass http://127.0.0.1:5170/health;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        access_log off;
    }

    # Static uploads folder with caching
    location /uploads/ {
        alias /path/to/server/uploads/;
        expires 7d;
        add_header Cache-Control "public, max-age=604800";
        
        # Enable sendfile for faster file serving
        sendfile on;
        tcp_nopush on;
        tcp_nodelay on;
    }

    # Gzip compression (reduces response size by 60-80%)
    gzip on;
    gzip_vary on;
    gzip_min_length 1024;
    gzip_proxied any;
    gzip_comp_level 5;
    gzip_types text/plain text/css text/xml text/javascript application/x-javascript application/xml application/javascript application/json;
    gzip_disable "MSIE [1-6]\.";
}

# ============================================
# OPTIONAL: Frontend on same server
# ============================================
