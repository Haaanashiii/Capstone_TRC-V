# Docker ignore file
# Reduces build context size and speeds up builds

# Dependencies
node_modules/
npm-debug.log*

# Environment files (use docker secrets or env vars instead)
.env
.env.*
!.env.example

# Logs
logs/
*.log

# Build artifacts
dist/
build/

# Test files
tests/
__tests__/
*.test.js
*.spec.js
coverage/

# IDE
.vscode/
.idea/

# OS files
.DS_Store
Thumbs.db

# Git
.git/
.gitignore

# Documentation
*.md
!README.md
docs/

# Backups
backups/

# Uploads (mount as volume instead)
uploads/

# Temporary files
tmp/
temp/
